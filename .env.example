# ==========================================
# VARIÁVEIS DE AMBIENTE (OPCIONAIS / CUSTOMIZÁVEIS)
# No Railway, você pode adicionar essas chaves na aba "Variables".
# ==========================================

# Chave de administrador do Cloudflare Worker
CHAVE_CLOUDFLARE=csad987cqa9dn1mnxcLXdna

# URL do Cloudflare Worker que envia para o Telegram
WORKER_URL=https://promo-bot.ofertasnomelibr.workers.dev/oferta/salvar

# Intervalo entre envios (em segundos). Padrão: 240 (4 minutos)
INTERVALO_SEGUNDOS=240

# Modo de envio:
# 'PARALELO' = A cada minuto, envia 1 oferta de CADA categoria ativa.
# 'ROTATIVO' = A cada minuto, envia 1 oferta alternando as categorias (Min 1: Tech, Min 2: Games, etc.)
MODO_ENVIO=PARALELO

# Cookies do Afiliado Mercado Livre (se quiser sobrescrever pelo Railway)
# ML_CSRF_TOKEN=
# ML_COOKIE=
